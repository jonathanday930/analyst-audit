ANTHROPIC_API_KEY=
# Only needed if ANTHROPIC_API_KEY is an "identity-linked" key (tied to a specific org member
# rather than a plain workspace key) — those 400 unless every request also names a workspace.
# Find it in the Console under Settings -> Workspaces. Leave unset for a plain API key.
ANTHROPIC_WORKSPACE_ID=
# Reserved for the planned Hugging Face provider migration. This is currently NOT read by
# app/config.py or app/llm/client.py; all live LLM calls still use Anthropic below. When the
# provider-neutral client is implemented, use a fine-grained HF token with Inference Providers
# permission and the router endpoint https://router.huggingface.co/v1.
HUGGINGFACE_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analyst_audit
PORT=8000
FRONTEND_URL=http://localhost:5173

# Optional: routes YouTube transcript fetches through Webshare's rotating residential proxies.
# Leave both unset for a direct connection (default). Set both to work around YouTube
# IP-blocking a dev machine after a burst of concurrent transcript fetches (see
# app/youtube/transcript.py). Get these from a Webshare account -> Proxy -> the
# username/password shown there, NOT your Webshare login credentials.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Optional: final transcript-fetch fallback via supadata.ai's hosted API, which fetches from
# YouTube on ITS OWN infrastructure rather than this machine's — unaffected by a local IP ban,
# unlike the Webshare proxy and yt-dlp fallback above, which both still hit YouTube directly.
# Leave unset to skip this fallback. Get a key at https://supadata.ai (dashboard -> API keys).
SUPADATA_API_KEY=

# Optional: third hosted transcript fallback via EasyTranscriber. It accepts the canonical
# YouTube URL and fetches from its own infrastructure. Leave unset to skip this fallback.
# Get a key at https://www.easytranscriber.com/ (API keys start with et_).
EASYTRANSCRIBER_API_KEY=

# Optional: final hosted transcript fallback via TranscriptFetch. It accepts a YouTube URL and
# returns timestamped transcript segments. Leave unset to skip this fallback.
# Get a key at https://transcriptfetch.com/ (API keys start with tf_live_).
TRANSCRIPTFETCH_API_KEY=

# Current model IDs for each pipeline pass. Despite the generic names, these are currently
# passed to Anthropic's API and must be Anthropic model IDs. Hugging Face model IDs will require
# the provider migration described in CLAUDE.md; changing these strings alone is insufficient.
CLAIM_FINDER_MODEL=claude-sonnet-5
STANCE_EXTRACTOR_MODEL=claude-sonnet-5
CLAIM_ANALYZER_MODEL=claude-sonnet-5
META_ANALYST_MODEL=claude-sonnet-5
